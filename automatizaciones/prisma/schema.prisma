// Prisma Schema para Asistente Personal Extendido
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// NotaAudio - Copia enriquecida de transcripción
// ============================================
model NotaAudio {
  id                    Int       @id @default(autoincrement())
  transcripcionId       Int       @unique // FK a mateos.notas_de_voz.id
  transcripcionCompleta String    @db.Text
  archivoAudioUrl       String?
  resumenEjecutivo      String?   @db.Text
  fechaGrabacion        DateTime  @default(now())
  procesado             Boolean   @default(false)
  tipoDetectado         String?   // "tarea", "registro", "idea", "compromiso", "sin_clasificar"
  confianzaDeteccion    Float?    // 0.0 - 1.0

  // Relaciones
  tareas                Tarea[]
  compromisos           Compromiso[]
  registros             Registro[]
  ideas                 IdeaCapturada[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([transcripcionId])
  @@index([procesado])
  @@index([tipoDetectado])
  @@index([fechaGrabacion])
  @@map("notas_audio")
}

// ============================================
// Tarea - Tareas TODO extraídas (V1)
// ============================================
model Tarea {
  id                Int       @id @default(autoincrement())
  titulo            String
  descripcion       String?   @db.Text
  fechaVencimiento  DateTime?
  prioridad         Prioridad @default(MEDIA)
  completada        Boolean   @default(false)
  fechaCompletada   DateTime?

  // Relaciones
  notaAudioId       Int
  notaAudio         NotaAudio @relation(fields: [notaAudioId], references: [id], onDelete: Cascade)

  proyectoEstrategicoId Int?                 @map("proyecto_estrategico_id")
  proyectoEstrategico   ProyectoEstrategico? @relation(fields: [proyectoEstrategicoId], references: [id])


  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([notaAudioId])
  @@index([completada])
  @@index([fechaVencimiento])
  @@index([prioridad])
  @@map("tareas")
}

// ============================================
// Compromiso - Compromisos con personas
// ============================================
model Compromiso {
  id                Int       @id @default(autoincrement())
  titulo            String
  descripcion       String?   @db.Text
  personaNombre     String
  fechaLimite       DateTime?
  yoMeComprometi    Boolean   @default(false) // true si YO prometí, false si otra persona
  cumplido          Boolean   @default(false)
  fechaCumplido     DateTime?

  // Relaciones
  notaAudioId       Int
  notaAudio         NotaAudio @relation(fields: [notaAudioId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([notaAudioId])
  @@index([cumplido])
  @@index([fechaLimite])
  @@index([personaNombre])
  @@map("compromisos")
}

// ============================================
// Registro - Actividades YA REALIZADAS (pasado)
// ============================================
model Registro {
  id                    Int       @id @default(autoincrement())
  descripcion           String    @db.Text
  duracionHoras         Float?
  proyectoNombre        String?   // Nombre del proyecto (texto libre, puede ser "otros")
  personasInvolucradas  String[]
  fechaActividad        DateTime  @default(now())

  // Relaciones
  notaAudioId           Int
  notaAudio             NotaAudio @relation(fields: [notaAudioId], references: [id], onDelete: Cascade)
  
  areaVidaId            Int?
  areaVida              AreasVida? @relation(fields: [areaVidaId], references: [id], onDelete: SetNull)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([notaAudioId])
  @@index([fechaActividad])
  @@index([areaVidaId])
  @@index([proyectoNombre])
  @@map("registros")
}

// ============================================
// Idea - Ideas capturadas
// ============================================
model IdeaCapturada {
  id                  Int       @id @default(autoincrement())
  titulo              String
  descripcion         String?   @db.Text
  categoria           String?
  implementada        Boolean   @default(false)
  fechaImplementacion DateTime?

  // Relaciones
  notaAudioId         Int
  notaAudio           NotaAudio @relation(fields: [notaAudioId], references: [id], onDelete: Cascade)

  proyectoEstrategicoId Int?                 @map("proyecto_estrategico_id")
  proyectoEstrategico   ProyectoEstrategico? @relation(fields: [proyectoEstrategicoId], references: [id])

  areaVidaId          Int?
  areaVida            AreasVida? @relation(fields: [areaVidaId], references: [id], onDelete: SetNull)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([notaAudioId])
  @@index([implementada])
  @@index([categoria])
  @@index([areaVidaId])
  @@map("ideas_capturadas")
}


// ============================================
// Modelos Estratégicos (V2)
// ============================================

// --- Tablas Taxativas ---

model AreasVida {
  id                  Int       @id @default(autoincrement())
  nombre              String    @unique @db.VarChar(100)
  descripcion         String?   @db.Text
  colorHex            String?   @map("color_hex") @db.VarChar(7)
  ordenVisualizacion  Int?      @map("orden_visualizacion")
  activa              Boolean?

  // Relaciones
  registros           Registro[]
  ideas               IdeaCapturada[]
  subProyectos        SubProyecto[]

  @@map("areas_vida")
}

model MotivosPersonales {
  id            Int       @id @default(autoincrement())
  nombre        String    @unique @db.VarChar(100)
  descripcion   String?   @db.Text
  icono         String?   @db.VarChar(20)
  pesoPersonal  Int?      @map("peso_personal")

  @@map("motivos_personales")
}

model Destrezas {
  id                Int          @id @default(autoincrement())
  nombre            String       @unique @db.VarChar(100)
  categoria         String?      @db.VarChar(50)
  nivelActual       Int?         @map("nivel_actual")
  descripcion       String?      @db.Text
  costoEnergetico   TipoEnergia? @map("costo_energetico")
  mejorMomentoDia   String[]     @map("mejor_momento_dia") // Changed to String[]
  requiereFlow      Boolean?     @map("requiere_flow")
  notasContexto     String?      @map("notas_contexto") @db.Text
  subtareasEstrategicas SubtareaEstrategica[]

  @@map("destrezas")
}

model Dificultades {
  id                  Int       @id @default(autoincrement())
  nombre              String    @unique @db.VarChar(100)
  categoria           String?   @db.VarChar(50)
  nivelImpacto        Int?      @map("nivel_impacto")
  descripcion         String?   @db.Text
  estrategiaMitigacion String?  @map("estrategia_mitigacion") @db.Text

  @@map("dificultades")
}

model MisionesVida {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(100)
  descripcion String?   @db.Text
  vision      String?   @db.Text
  prioridad   Int?

  @@map("misiones_vida")
}


// --- Tablas Generativas ---

model ProyectoEstrategico {
  id Int @id @default(autoincrement())
  nombre                    String    @db.VarChar(200)
  descripcion               String?   @db.Text
  areasIds                  Int[]     @map("areas_ids")
  motivosIds                Int[]     @map("motivos_ids")
  destrezasRequeridasIds    Int[]     @map("destrezas_requeridas_ids")
  dificultadesIds           Int[]     @map("dificultades_ids")
  misionesIds               Int[]     @map("misiones_ids")
  justificacionEstrategica  Json?     @map("justificacion_estrategica")
  objetivosSmart            Json?     @map("objetivos_smart")
  fechaInicio               DateTime? @map("fecha_inicio") @db.Date
  fechaFinEstimada          DateTime? @map("fecha_fin_estimada") @db.Date
  estado                    TipoEstadoProyecto @default(idea)
  prioridadGlobal           Decimal?  @map("prioridad_global") @db.Decimal(3, 2)
  scoreMotivacional         Decimal?  @map("score_motivacional") @db.Decimal(3, 2)
  scoreAlineacion           Decimal?  @map("score_alineacion") @db.Decimal(3, 2)
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  // Relaciones
  tareasEstrategicas TareaEstrategica[]
  logsGeneracion     LogGeneracionIA[]
  ideasCapturadas    IdeaCapturada[]
  tareasSimples      Tarea[]
  subProyectos       SubProyecto[]
  contactosProyectosEstrategicos ContactoProyectoEstrategico[]
  personasProyectos  PersonaProyecto[]

  @@map("proyectos_estrategicos")
}

model TareaEstrategica {
  id                           Int                    @id @default(autoincrement())
  proyectoId                   Int                    @map("proyecto_id")
  proyecto                     ProyectoEstrategico    @relation(fields: [proyectoId], references: [id])
  nombre                       String                 @db.VarChar(255)
  descripcion                  String?                @db.Text
  orden                        Int?
  moscow                       TipoMoscow?
  tiempoEstimadoHoras          Int?                   @map("tiempo_estimado_horas")
  nivelRiesgo                  TipoRiesgo?            @map("nivel_riesgo")
  prioridadVelocidadPerfeccion TipoEnfoque?           @map("prioridad_velocidad_perfeccion")
  estadoKanban                 TipoEstadoKanban       @default(backlog) @map("estado_kanban")
  fechaDone                    DateTime?              @map("fecha_done") @db.Timestamp
  impacto                      TipoImpacto?           @map("impacto")
  urgencia                     TipoUrgencia?          @map("urgencia")
  eisenhower                   TipoEisenhower?        @map("eisenhower")
  fechaInicio                  DateTime?              @map("fecha_inicio") @db.Date
  fechaFin                     DateTime?              @map("fecha_fin") @db.Date
  deadLine                     DateTime?              @map("dead_line") @db.Date
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")
  subtareasEstrategicas        SubtareaEstrategica[]

  @@index([deadLine])
  @@map("tareas_estrategicas")
}

model SubtareaEstrategica {
  id                    Int                 @id @default(autoincrement())
  tareaEstrategicaId    Int                 @map("tarea_estrategica_id")
  tareaEstrategica      TareaEstrategica    @relation(fields: [tareaEstrategicaId], references: [id])
  nombre                String              @db.VarChar(255)
  estadoKanban          TipoEstadoKanban    @default(backlog) @map("estado_kanban")
  fechaDone             DateTime?           @map("fecha_done") @db.Timestamp
  tiempoEstimadoMinutos Int?                @map("tiempo_estimado_minutos")
  moscow                TipoMoscow?
  destrezaPrincipalId   Int?                @map("destreza_principal_id")
  destrezaPrincipal     Destrezas?          @relation(fields: [destrezaPrincipalId], references: [id])
  fechaInicio           DateTime?           @map("fecha_inicio") @db.Date
  fechaFin              DateTime?           @map("fecha_fin") @db.Date
  deadLine              DateTime?           @map("dead_line") @db.Date
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  itemsEstrategicos     ItemEstrategico[]

  @@index([deadLine])
  @@map("subtareas_estrategicas")
}

model ItemEstrategico {
  id                    Int                 @id @default(autoincrement())
  subtareaEstrategicaId Int                 @map("subtarea_estrategica_id")
  subtareaEstrategica   SubtareaEstrategica @relation(fields: [subtareaEstrategicaId], references: [id], onDelete: Cascade)
  nombre                String              @db.VarChar(255)
  done                  Boolean             @default(false)
  fechaDone             DateTime?           @map("fecha_done") @db.Timestamp
  tiempoEstimadoMinutos Int?                @map("tiempo_estimado_minutos")
  moscow                TipoMoscow?
  fechaInicio           DateTime?           @map("fecha_inicio") @db.Date
  fechaFin              DateTime?           @map("fecha_fin") @db.Date
  deadLine              DateTime?           @map("dead_line") @db.Date
  proyectoNombre        String?             @map("proyecto_nombre") @db.VarChar(200)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@index([subtareaEstrategicaId])
  @@index([done])
  @@index([deadLine])
  @@index([proyectoNombre])
  @@map("items_estrategicos")
}


model LogGeneracionIA {
  id             Int       @id @default(autoincrement())
  proyectoId     Int?      @map("proyecto_id")
  proyecto       ProyectoEstrategico? @relation(fields: [proyectoId], references: [id])
  tipoGeneracion String?   @map("tipo_generacion") @db.VarChar(50)
  modeloIa       String?   @map("modelo_ia") @db.VarChar(100)
  tokensUsados   Int?      @map("tokens_usados")
  prompt         String?   @db.Text
  respuesta      String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("logs_generacion_ia")
}

// ============================================
// Enums
// ============================================

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TipoMoscow {
  must
  should
  could
  wont
}

enum TipoEnfoque {
  velocidad
  perfeccion
  balanceado
}

enum TipoLibertad {
  receta
  resultado
  mixto
}

enum TipoRiesgo {
  bajo
  medio
  alto
  critico
}

enum TipoEnergia {
  relax
  baja
  media
  alta
  pico
}

enum TipoEstadoProyecto {
  idea
  planificacion
  en_curso
  pausado
  completado
  cancelado
  archivado
}

enum TipoEstadoTarea {
  por_hacer
  en_progreso
  bloqueada
  en_revision
  completada
  cancelada
}

enum TipoEstadoKanban {
  freezer
  backlog
  waiting
  todo
  doing
  done
}

enum TipoImpacto {
  alto
  medio
  bajo
}

enum TipoUrgencia {
  alta
  media
  baja
}

enum TipoEisenhower {
  cuadrante_1
  cuadrante_2
  cuadrante_3
  cuadrante_4
}

// ============================================
// Transcripcion - Modelo original para compatibilidad con mateos-next-app
// ============================================
model Transcripcion {
  id                 Int      @id @default(autoincrement())
  hora               DateTime @default(now()) @db.Timestamptz(6)
  texto              String   @db.Text
  r2_url             String?  @db.VarChar(512)
  r2_key             String?  @db.VarChar(256)
  telegram_file_id   String?  @db.VarChar(256)
  telegram_user_id   BigInt?
  telegram_message_id BigInt?
  duracion_segundos  Int?
  tamano_bytes       BigInt?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)
  estado             EstadoProcesamiento @default(PROCESANDO)
  error_msg          String?  @db.Text

  @@index([telegram_user_id])
  @@index([created_at])
  @@index([estado])
  @@map("transcripciones")
}

enum EstadoProcesamiento {
  PROCESANDO
  COMPLETADO
  ERROR
}

// ============================================
// Sistema de Personas, Organizaciones y Sub-proyectos (2026-01-30)
// ============================================

model Persona {
  id                    Int       @id @default(autoincrement())
  nombreCompleto        String    @map("nombre_completo") @db.VarChar(255)
  apodo                 String?   @db.VarChar(100)
  trato                 String?   @db.VarChar(50) // formal, coloquial, informal, jocoso
  email                 String?   @db.VarChar(255)
  telefono              String?   @db.VarChar(50)
  whatsapp              String?   @db.VarChar(50)
  instagram             String?   @db.VarChar(100)
  xTwitter              String?   @map("x_twitter") @db.VarChar(100)
  tiktok                String?   @db.VarChar(100)
  linkedin              String?   @db.VarChar(500)
  youtube               String?   @db.VarChar(500)
  tipoRelacion          String?   @map("tipo_relacion") @db.VarChar(50) // voluntario, cliente, colaborador, donante, beneficiario, aliado, mentor, amigo
  esContactoEstrella    Boolean   @default(false) @map("es_contacto_estrella")
  puntuacionImportancia Int?      @map("puntuacion_importancia")
  fechaUltimoContacto   DateTime? @map("fecha_ultimo_contacto") @db.Date
  frecuenciaContactoIdeal String? @map("frecuencia_contacto_ideal") @db.VarChar(50) // diario, semanal, quincenal, mensual, trimestral, semestral, anual
  eneatipo              String?   @db.VarChar(50)
  intereses             String[]
  otraInformacion       String?   @map("otra_informacion") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relaciones
  personasOrganizaciones PersonaOrganizacion[]
  contactosPersonas      ContactoPersona[]
  personasProyectos      PersonaProyecto[]
  subProyectosLiderados  SubProyecto[] @relation("PersonaLider")

  @@index([nombreCompleto])
  @@index([tipoRelacion])
  @@index([esContactoEstrella])
  @@map("personas")
}

model Organizacion {
  id                    Int       @id @default(autoincrement())
  nombreOrganizacion    String    @map("nombre_organizacion") @db.VarChar(255)
  nombreCorto           String?   @map("nombre_corto") @db.VarChar(100)
  siglas                String?   @db.VarChar(20)
  tipoOrganizacion      String?   @map("tipo_organizacion") @db.VarChar(50) // ong, fundacion, empresa_social, empresa_privada, gobierno, universidad, colectivo, cooperativa, asociacion_civil, startup, multinacional
  sectorActividad       String?   @map("sector_actividad") @db.VarChar(100)
  miVinculo             String?   @map("mi_vinculo") @db.Text
  emailPrincipal        String?   @map("email_principal") @db.VarChar(255)
  telefonoPrincipal     String?   @map("telefono_principal") @db.VarChar(50)
  sitioWeb              String?   @map("sitio_web") @db.VarChar(500)
  direccion             String?   @db.Text
  ciudad                String?   @db.VarChar(100)
  pais                  String?   @default("Uruguay") @db.VarChar(100)
  instagram             String?   @db.VarChar(100)
  xTwitter              String?   @map("x_twitter") @db.VarChar(100)
  tiktok                String?   @db.VarChar(100)
  linkedin              String?   @db.VarChar(500)
  youtube               String?   @db.VarChar(500)
  facebook              String?   @db.VarChar(500)
  naturalezaRelacion    String?   @map("naturaleza_relacion") @db.VarChar(50) // aliado_estrategico, proveedor_servicios, cliente, financiador, beneficiario, socio, competidor_amigable
  esOrganizacionEstrella Boolean  @default(false) @map("es_organizacion_estrella")
  puntuacionImportancia Int?      @map("puntuacion_importancia")
  fechaPrimerContacto   DateTime? @map("fecha_primer_contacto") @db.Date
  fechaUltimoContacto   DateTime? @map("fecha_ultimo_contacto") @db.Date
  frecuenciaContactoIdeal String? @map("frecuencia_contacto_ideal") @db.VarChar(50)
  misionVision          String?   @map("mision_vision") @db.Text
  areasTrabajo          String[]  @map("areas_trabajo")
  rse                   String?   @db.Text
  haceVoluntariado      String?   @map("hace_voluntariado") @db.Text
  tamanioOrganizacion   String?   @map("tamanio_organizacion") @db.VarChar(50) // micro, pequena, mediana, grande
  notasAdicionales      String?   @map("notas_adicionales") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relaciones
  personasOrganizaciones    PersonaOrganizacion[]
  contactosOrganizaciones   ContactoOrganizacion[]
  subProyectosLiderados     SubProyecto[] @relation("OrganizacionLider")
  subProyectosOrganizaciones SubProyectoOrganizacion[]

  @@index([nombreOrganizacion])
  @@index([tipoOrganizacion])
  @@index([esOrganizacionEstrella])
  @@map("organizaciones")
}

model PersonaOrganizacion {
  id                Int       @id @default(autoincrement())
  personaId         Int       @map("persona_id")
  persona           Persona   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  organizacionId    Int       @map("organizacion_id")
  organizacion      Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  cargoTitulo       String?   @map("cargo_titulo") @db.VarChar(255)
  tipoVinculacion   String?   @map("tipo_vinculacion") @db.VarChar(50) // empleado, voluntario, consultor, directivo, socio, fundador, asesor, pasante
  fechaInicio       DateTime? @map("fecha_inicio") @db.Date
  fechaFin          DateTime? @map("fecha_fin") @db.Date
  esActual          Boolean   @default(true) @map("es_actual")
  nivelDecision     String?   @map("nivel_decision") @db.VarChar(50) // estrategico, tactico, operativo, ninguno
  responsabilidades String?   @db.Text
  logrosDestacados  String?   @map("logros_destacados") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([personaId, organizacionId, cargoTitulo])
  @@index([personaId])
  @@index([organizacionId])
  @@index([esActual])
  @@map("personas_organizaciones")
}

model SubProyecto {
  id                    Int       @id @default(autoincrement())
  nombre                String    @db.VarChar(255)
  nombreCorto           String?   @map("nombre_corto") @db.VarChar(100)
  codigoProyecto        String?   @unique @map("codigo_proyecto") @db.VarChar(50)
  areaVidaId            Int?      @map("area_vida_id")
  areaVida              AreasVida? @relation(fields: [areaVidaId], references: [id], onDelete: SetNull)
  proyectoEstrategicoId Int?      @map("proyecto_estrategico_id")
  proyectoEstrategico   ProyectoEstrategico? @relation(fields: [proyectoEstrategicoId], references: [id], onDelete: SetNull)
  descripcion           String?   @db.Text
  objetivoGeneral       String?   @map("objetivo_general") @db.Text
  objetivosEspecificos  String[]  @map("objetivos_especificos")
  estado                String    @default("idea") @db.VarChar(50) // idea, planificacion, aprobado, activo, pausado, completado, cancelado, archivado
  fechaInicio           DateTime? @map("fecha_inicio") @db.Date
  fechaFinEstimada      DateTime? @map("fecha_fin_estimada") @db.Date
  fechaFinReal          DateTime? @map("fecha_fin_real") @db.Date
  duracionEstimadaMeses Int?      @map("duracion_estimada_meses")
  prioridad             String    @default("media") @db.VarChar(50) // baja, media, alta, critica, estrategica
  porcentajeCompletado  Int       @default(0) @map("porcentaje_completado")
  organizacionLiderId   Int?      @map("organizacion_lider_id")
  organizacionLider     Organizacion? @relation("OrganizacionLider", fields: [organizacionLiderId], references: [id], onDelete: SetNull)
  personaLiderId        Int?      @map("persona_lider_id")
  personaLider          Persona?  @relation("PersonaLider", fields: [personaLiderId], references: [id], onDelete: SetNull)
  miResponsabilidad     String?   @map("mi_responsabilidad") @db.VarChar(50) // liderar, liderar_seccion, participacion_horizontal, apoyar, asesorar, seguimiento
  presupuestoEstimado   Decimal?  @map("presupuesto_estimado") @db.Decimal(15, 2)
  presupuestoAprobado   Decimal?  @map("presupuesto_aprobado") @db.Decimal(15, 2)
  presupuestoEjecutado  Decimal?  @map("presupuesto_ejecutado") @db.Decimal(15, 2)
  moneda                String    @default("UYU") @db.VarChar(10)
  misHorasPresupuestadas Decimal? @map("mis_horas_presupuestadas") @db.Decimal(8, 2)
  misHorasEjecutadas    Decimal?  @map("mis_horas_ejecutadas") @db.Decimal(8, 2)
  indicadoresExito      String[]  @map("indicadores_exito")
  resultadosAlcanzados  String?   @map("resultados_alcanzados") @db.Text
  aprendizajes          String?   @db.Text
  etiquetas             String[]
  notasInternas         String?   @map("notas_internas") @db.Text
  comoSurgio            String?   @map("como_surgio") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relaciones
  subProyectosOrganizaciones SubProyectoOrganizacion[]
  contactosSubProyectos      ContactoSubProyecto[]
  personasProyectos          PersonaProyecto[]

  @@index([nombre])
  @@index([estado])
  @@index([prioridad])
  @@index([areaVidaId])
  @@index([proyectoEstrategicoId])
  @@map("sub_proyectos")
}

model SubProyectoOrganizacion {
  id                Int          @id @default(autoincrement())
  subProyectoId     Int          @map("sub_proyecto_id")
  subProyecto       SubProyecto  @relation(fields: [subProyectoId], references: [id], onDelete: Cascade)
  organizacionId    Int          @map("organizacion_id")
  organizacion      Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  rolOrganizacion   String?      @map("rol_organizacion") @db.VarChar(100)
  fechaIncorporacion DateTime?   @map("fecha_incorporacion") @db.Date
  createdAt         DateTime     @default(now()) @map("created_at")

  @@unique([subProyectoId, organizacionId])
  @@index([subProyectoId])
  @@index([organizacionId])
  @@map("sub_proyectos_organizaciones")
}

model Contacto {
  id                    Int       @id @default(autoincrement())
  tipoContacto          String?   @map("tipo_contacto") @db.VarChar(50) // reunion, llamada, email, whatsapp, mensaje_directo, videollamada, evento, casual, almuerzo, cafe
  canalContacto         String?   @map("canal_contacto") @db.VarChar(50) // presencial, zoom, meet, teams, telefono, instagram, linkedin, twitter, email, whatsapp
  fechaContacto         DateTime  @map("fecha_contacto")
  asunto                String?   @db.VarChar(500)
  resumen               String?   @db.Text
  acuerdosAlcanzados    String[]  @map("acuerdos_alcanzados")
  tareasGeneradas       String[]  @map("tareas_generadas") // Texto libre, sin FK
  compromisosGenerados  String[]  @map("compromisos_generados") // Texto libre, sin FK
  requiereSeguimiento   Boolean   @default(false) @map("requiere_seguimiento")
  fechaProximoContacto  DateTime? @map("fecha_proximo_contacto") @db.Date
  notasSeguimiento      String?   @map("notas_seguimiento") @db.Text
  otrasPersonasPresentes String[] @map("otras_personas_presentes") // Texto libre
  documentosAdjuntos    String[]  @map("documentos_adjuntos") // URLs
  transcripcionExternaId String?  @map("transcripcion_externa_id") @db.VarChar(255) // ID o URL externa
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relaciones
  contactosPersonas             ContactoPersona[]
  contactosOrganizaciones       ContactoOrganizacion[]
  contactosSubProyectos         ContactoSubProyecto[]
  contactosProyectosEstrategicos ContactoProyectoEstrategico[]

  @@index([fechaContacto])
  @@index([tipoContacto])
  @@index([requiereSeguimiento])
  @@map("contactos")
}

model ContactoPersona {
  id          Int      @id @default(autoincrement())
  contactoId  Int      @map("contacto_id")
  contacto    Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  personaId   Int      @map("persona_id")
  persona     Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([contactoId, personaId])
  @@index([contactoId])
  @@index([personaId])
  @@map("contactos_personas")
}

model ContactoOrganizacion {
  id             Int          @id @default(autoincrement())
  contactoId     Int          @map("contacto_id")
  contacto       Contacto     @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  organizacionId Int          @map("organizacion_id")
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([contactoId, organizacionId])
  @@index([contactoId])
  @@index([organizacionId])
  @@map("contactos_organizaciones")
}

model ContactoSubProyecto {
  id            Int         @id @default(autoincrement())
  contactoId    Int         @map("contacto_id")
  contacto      Contacto    @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  subProyectoId Int         @map("sub_proyecto_id")
  subProyecto   SubProyecto @relation(fields: [subProyectoId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([contactoId, subProyectoId])
  @@index([contactoId])
  @@index([subProyectoId])
  @@map("contactos_sub_proyectos")
}

model ContactoProyectoEstrategico {
  id                    Int                 @id @default(autoincrement())
  contactoId            Int                 @map("contacto_id")
  contacto              Contacto            @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  proyectoEstrategicoId Int                 @map("proyecto_estrategico_id")
  proyectoEstrategico   ProyectoEstrategico @relation(fields: [proyectoEstrategicoId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now()) @map("created_at")

  @@unique([contactoId, proyectoEstrategicoId])
  @@index([contactoId])
  @@index([proyectoEstrategicoId])
  @@map("contactos_proyectos_estrategicos")
}

model PersonaProyecto {
  id                    Int                  @id @default(autoincrement())
  personaId             Int                  @map("persona_id")
  persona               Persona              @relation(fields: [personaId], references: [id], onDelete: Cascade)
  proyectoEstrategicoId Int?                 @map("proyecto_estrategico_id")
  proyectoEstrategico   ProyectoEstrategico? @relation(fields: [proyectoEstrategicoId], references: [id], onDelete: Cascade)
  subProyectoId         Int?                 @map("sub_proyecto_id")
  subProyecto           SubProyecto?         @relation(fields: [subProyectoId], references: [id], onDelete: Cascade)
  rolProyecto           String?              @map("rol_proyecto") @db.VarChar(100) // coordinador, voluntario, beneficiario, mentor, asesor, donante, facilitador
  fechaInicioParticipacion DateTime?         @map("fecha_inicio_participacion") @db.Date
  fechaFinParticipacion DateTime?            @map("fecha_fin_participacion") @db.Date
  estadoParticipacion   String               @default("activo") @map("estado_participacion") @db.VarChar(50) // activo, inactivo, pausado, completado
  horasDedicadas        Decimal?             @map("horas_dedicadas") @db.Decimal(8, 2)
  contribucionDestacada String?              @map("contribucion_destacada") @db.Text
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  @@index([personaId])
  @@index([proyectoEstrategicoId])
  @@index([subProyectoId])
  @@index([estadoParticipacion])
  @@map("personas_proyectos")
}
